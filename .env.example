# Copiar a .env y completar antes de levantar el stack con docker-compose.

# --- Postgres (servicio "postgres" en docker-compose.yml) ---
POSTGRES_PASSWORD=
# Solo necesarios si te conectas desde fuera de docker-compose con otros valores.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=agent-larry
# POSTGRES_USER=agent

# --- Agent (agent/agent.py) ---
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
# Kokoro TTS corre local (kokoro-onnx) y no necesita API key; descarga el
# modelo (~/.cache/pipecat/kokoro-onnx) en el primer uso. Voz por defecto:
# em_alex (espanol, masculina). Alternativas en espanol: ef_dora (femenina),
# em_santa (masculina, voz de personaje "Santa").
KOKORO_VOICE_ID=em_alex

# --- RAG (agent/rag/) ---
# Valores por defecto pensados para el servicio "chromadb" de docker-compose.yml.
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# CHROMA_COLLECTION=post_operatorio
# GEMINI_EMBED_MODEL=gemini-embedding-2
# RAG_TOP_K=4
